+package com.replaymod.replaystudio.protocol;
+
+import com.github.steveice10.netty.buffer.ByteBuf;
+import com.github.steveice10.netty.buffer.Unpooled;
+import com.replaymod.replaystudio.lib.viaversion.api.protocol.packet.State;
+import com.replaymod.replaystudio.lib.viaversion.api.protocol.version.ProtocolVersion;
+import com.replaymod.replaystudio.protocol.packets.*;
+import com.replaymod.replaystudio.protocol.registry.Registries;
+import com.replaymod.replaystudio.util.DPosition;
+import com.replaymod.replaystudio.util.Location;
+import org.apache.commons.lang3.tuple.Pair;
+import org.apache.commons.lang3.tuple.Triple;
+import org.junit.Test;
+
+import static org.junit.Assert.*;
+
+public class Packet26_3Test {
+    private Packet packet(PacketType type, byte[] bytes) {
+        return new Packet(PacketTypeRegistry.get(ProtocolVersion.v26_3, State.PLAY), type,
+                Unpooled.wrappedBuffer(bytes));
+    }
+
+    @Test
+    public void steppedMovementUsesAllDeltas() throws Exception {
+        // Vanilla 26.3: id, packed step count/onGround, tick offset and three shorts per step, rotation.
+        Packet packet = packet(PacketType.EntityPositionRotation, new byte[]{
+                42, 5, 1, 16, 0, 0, 0, -16, 0, 3, 0, 0, 32, 0, 16, 0, 64, -64});
+        try {
+            Triple<DPosition, Pair<Float, Float>, Boolean> movement = PacketEntityMovement.getMovement(packet);
+            assertEquals(new DPosition(1, 2, 0), movement.getLeft());
+            assertEquals(Pair.of(90f, -90f), movement.getMiddle());
+            assertTrue(movement.getRight());
+        } finally {
+            packet.release();
+        }
+    }
+
+    @Test
+    public void rotationReadsGroundFlagBeforeAngles() throws Exception {
+        Packet packet = packet(PacketType.EntityRotation, new byte[]{42, 0, 64, 32});
+        try {
+            Triple<DPosition, Pair<Float, Float>, Boolean> movement = PacketEntityMovement.getMovement(packet);
+            assertNull(movement.getLeft());
+            assertEquals(Pair.of(90f, 45f), movement.getMiddle());
+            assertFalse(movement.getRight());
+        } finally {
+            packet.release();
+        }
+    }
+
+    @Test
+    public void respawnAbsentPreviousModePreservesFollowingFields() throws Exception {
+        ByteBuf bytes = Unpooled.buffer();
+        bytes.writeByte(0); // dimension type id
+        writeString(bytes, "minecraft:overworld");
+        bytes.writeLong(1234);
+        bytes.writeByte(1); // current mode (varint)
+        bytes.writeBoolean(false); // no previous mode
+        bytes.writeBoolean(true); // debug world
+        bytes.writeBoolean(false); // flat world
+        bytes.writeBoolean(false); // no death location
+        bytes.writeByte(2); // portal cooldown
+        bytes.writeByte(63); // sea level
+        bytes.writeByte(3); // retain attributes and tracked data
+        Packet packet = new Packet(PacketTypeRegistry.get(ProtocolVersion.v26_3, State.PLAY), PacketType.Respawn, bytes);
+        try {
+            PacketRespawn respawn = PacketRespawn.read(packet, new Registries());
+            assertEquals(1, respawn.gameMode);
+            assertEquals(-1, respawn.prevGameMode);
+            assertTrue(respawn.debugWorld);
+            assertEquals(2, respawn.portalCooldown);
+            assertEquals(63, respawn.seaLevel);
+            assertTrue(respawn.keepPlayerAttributes);
+            assertTrue(respawn.keepPlayerDataTracker);
+            Packet rewritten = respawn.write(packet.getRegistry());
+            try {
+                assertEquals(bytes, rewritten.getBuf());
+            } finally {
+                rewritten.release();
+            }
+        } finally {
+            packet.release();
+        }
+    }
+
+    @Test
+    public void positionSyncReadsTypedPath() throws Exception {
+        ByteBuf bytes = Unpooled.buffer();
+        bytes.writeByte(42);
+        bytes.writeByte(0); // linear path
+        bytes.writeDouble(1.25);
+        bytes.writeDouble(64);
+        bytes.writeDouble(-2.5);
+        bytes.writeFloat(90);
+        bytes.writeFloat(30);
+        bytes.writeBoolean(true);
+        Packet packet = new Packet(PacketTypeRegistry.get(ProtocolVersion.v26_3, State.PLAY), PacketType.EntityTeleport, bytes);
+        try {
+            Location location = PacketEntityTeleport.getLocation(packet);
+            assertEquals(new Location(1.25, 64, -2.5, 90, 30), location);
+            Packet rewritten = PacketEntityTeleport.write(packet.getRegistry(), 42, location, true);
+            try {
+                assertEquals(bytes, rewritten.getBuf());
+            } finally {
+                rewritten.release();
+            }
+        } finally {
+            packet.release();
+        }
+    }
+
+    private void writeString(ByteBuf buf, String value) throws Exception {
+        byte[] bytes = value.getBytes("UTF-8");
+        buf.writeByte(bytes.length);
+        buf.writeBytes(bytes);
+    }
+}
